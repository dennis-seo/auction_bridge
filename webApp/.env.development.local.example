# 이 파일을 .env.development.local 로 복사한 뒤 실제 키를 채우세요.
# .env.development.local 은 git 에서 제외됩니다.
#
# 카카오 JS 키 — KAKAO_JS_KEY 로 등록하세요. 호환성을 위해 VITE_KAKAO_JS_KEY 도 인식.
KAKAO_JS_KEY=

# auction_bridge_server 가 다른 호스트/포트라면 base URL 을 빌드타임에 주입하도록
# shared 모듈을 확장한 뒤 사용. 기본값은 http://localhost:8000 (PlatformModule.js.kt).
#
# 서버에서 CORS_ORIGINS 환경변수에 webApp dev 서버 origin (예: http://localhost:8080) 을
# 반드시 추가해야 한다. (기본값은 http://localhost:3000 만 허용)
