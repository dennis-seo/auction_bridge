# Vercel Project Settings → Environment Variables 에 동일 키로 입력하세요.
# 이 파일은 git 에 추적됩니다(예시값 X).

# 카카오 Maps JavaScript Key
# https://developers.kakao.com → 내 애플리케이션 → JavaScript 키
# 운영 도메인을 카카오 콘솔의 "플랫폼 → Web 사이트 도메인" 에 추가해야 작동.
# (vite.config.ts 의 define 으로 client 번들에 주입됨 — VITE_ prefix 불필요)
KAKAO_JS_KEY=

# FastAPI 서버의 절대 URL (예: https://api.example.com)
# 미입력 시 http://localhost:8000 → 운영 빌드에서는 반드시 채울 것.
VITE_API_BASE_URL=
